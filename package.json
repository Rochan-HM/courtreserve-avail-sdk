{
  "name": "courtreserve-availability",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only court availability search with an offline planner. CourtReserve member password login is not a documented API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "courtreserve-availability": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contracts",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "npm run build && tsx --test test/integration/entry.test.ts",
    "check": "npm run build && npm run typecheck && npm test && tsx --test test/integration/entry.test.ts",
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
