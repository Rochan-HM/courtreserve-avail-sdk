    "paths": {
      "/api/v1/courtsapp/availability": {
        "get": {
          "tags": [
            "CourtsApp"
          ],
          "summary": "This service returns court availability for a single date OR a date range (max 31 days).",
          "description": "Both query forms return the SAME response shape \u2014 a date-range wrapper:\r\n{ FromDate, ToDate, TimeZone, Days: [{ Date, TimeZone, Courts: [...] }, ...] }.\r\n            \r\n1. **Single day** \u2014 pass ?date=YYYY-MM-DD. Returns the wrapper with a\r\n   one-element Days[] and FromDate == ToDate.\r\n            \r\n2. **Date range** \u2014 pass ?fromDate=YYYY-MM-DD&amp;toDate=YYYY-MM-DD. Returns one\r\n   Days[] entry per date in the range (capped at 31 days; request more \u2192 400 VALIDATION).\r\n            \r\nReturning one unified shape (rather than a flat { Date, Courts } for the single-day\r\nform) keeps the documented 200 schema honest for every input, so a generated client can\r\nalways read Days[] without branching on the query it sent. See \u00a7 6.2 / \u00a7 6.8 of\r\ndocs/COURTS_APP_INTEGRATION.md.\r\n            \r\nMixing both shapes (passing date alongside fromDate/toDate) returns 400.\r\nPricing rules can vary by day-of-week, so each day's Cost and FeeType\r\nreflects that day's effective price for the configured membership.\r\n            \r\nAll date/time values are facility-local wall-clock time, interpreted in the org's IANA\r\nTimeZone (surfaced at the response root and on each day \u2014 Q10).",
          "operationId": "CourtsApp_GetAvailability",
          "consumes": [],
          "produces": [
            "application/json",
            "text/json",
            "application/xml",
            "text/xml"
          ],
          "parameters": [
            {
              "name": "date",
              "in": "query",
              "description": "Single date (yyyy-MM-dd, facility-local). Mutually exclusive with fromDate/toDate.",
              "required": false,
              "type": "string",
              "format": "date"
            },
            {
              "name": "fromDate",
              "in": "query",
              "description": "Start of date range (yyyy-MM-dd, inclusive). Pair with toDate.",
              "required": false,
              "type": "string",
              "format": "date"
            },
            {
              "name": "toDate",
              "in": "query",
              "description": "End of date range (yyyy-MM-dd, inclusive). Pair with fromDate. Range capped at 31 days.",
              "required": false,
              "type": "string",
              "format": "date"
            },
            {
              "name": "courtTypeId",
              "in": "query",
              "description": "Filter by court type ID (optional).",
              "required": false,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "200": {
              "description": "Availability retrieved successfully.",
              "schema": {
                "$ref": "#/definitions/CourtsAppRangeAvailabilityResponse"
              }
            },
            "400": {
              "description": "Invalid date parameters (missing/mixed query shape, range > 31 days, toDate < fromDate).",
              "schema": {
                "$ref": "#/definitions/CourtsAppErrorResponse"
              }
            },
            "401": {
              "description": "Invalid or missing API credentials."
            },
            "500": {
              "description": "Server error.",
              "schema": {
                "$ref": "#/definitions/CourtsAppErrorResponse"
              }
            }
          }
        }
      },
      "/api/v1/courtsapp/courts": {
        "get": {
          "tags": [
            "CourtsApp"
          ],
          "summary": "This service returns the static catalog of courts available within the organization.",
          "description": "Returns court id, label, court type id and court type name for every active,\r\nnon-disabled court. Does NOT include per-day operating hours or reservation slots \u2014\r\nfor those, call /availability with a date range.",
          "operationId": "CourtsApp_GetCourts",
          "consumes": [],
          "produces": [
            "application/json",
            "text/json",
            "application/xml",
            "text/xml"
          ],
          "responses": {
            "200": {
              "description": "Courts retrieved successfully.",
              "schema": {
                "items": {
                  "$ref": "#/definitions/CourtsAppCourtCatalogResponse"
                },
                "xml": {
                  "name": "CourtsAppCourtCatalogResponse",
                  "wrapped": true
                },
                "type": "array"
              }
            },
            "401": {
              "description": "Invalid or missing API credentials."
            },
            "500": {
              "description": "Server error.",
              "schema": {
                "$ref": "#/definitions/CourtsAppErrorResponse"
              }
            }
          }
        }
      },
      "/api/v1/courtsapp/reservation-types": {
        "get": {
          "tags": [
            "CourtsApp"
          ],
