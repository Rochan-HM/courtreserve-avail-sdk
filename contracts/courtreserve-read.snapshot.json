    "paths": {
      "/api/v1/reservation/availability": {
        "get": {
          "tags": [
            "Reservation"
          ],
          "summary": "This service returns court availability \u2014 each court's operating hours and the time\r\nslots already booked on it \u2014 for a single date OR a date range (max 31 days).\r\nRequires the Reservation role with Read permission.",
          "description": "Both query forms return the SAME shape \u2014 a date-range wrapper\r\n{ FromDate, ToDate, TimeZone, Days: [{ Date, TimeZone, Courts: [...] }, ...] }.\r\nPass date for a single day (one-element Days, FromDate == ToDate),\r\nOR fromDate + toDate for a range (one Days entry per date, capped at\r\n31 days). Passing date together with fromDate/toDate is rejected.\r\nAll date/time values are facility-local wall-clock time, interpreted in the org's IANA\r\nTimeZone (surfaced at the response root and on each day). Pricing is not included\r\non this surface. This mirrors the CourtsApp marketplace availability endpoint, reusing\r\nthe same org-scoped stored procedures.",
          "operationId": "Reservation_Availability",
          "consumes": [],
          "produces": [
            "application/json",
            "text/json",
            "application/xml",
            "text/xml"
          ],
          "parameters": [
            {
              "name": "date",
              "in": "query",
              "description": "Single date (yyyy-MM-dd, facility-local). Mutually exclusive with fromDate/toDate.",
              "required": false,
              "type": "string",
              "format": "date-time"
            },
            {
              "name": "fromDate",
              "in": "query",
              "description": "Start of date range (yyyy-MM-dd, inclusive). Pair with toDate.",
              "required": false,
              "type": "string",
              "format": "date-time"
            },
            {
              "name": "toDate",
              "in": "query",
              "description": "End of date range (yyyy-MM-dd, inclusive). Pair with fromDate. Range capped at 31 days.",
              "required": false,
              "type": "string",
              "format": "date-time"
            },
            {
              "name": "courtTypeId",
              "in": "query",
              "description": "Filter by court type ID (optional).",
              "required": false,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "schema": {
                "$ref": "#/definitions/GenericEnterpriseApiResponseOfCourtAvailabilityApiResponse"
              }
            }
          }
        }
      },
